<%
  var r = typeof recipe !== "undefined" && recipe ? recipe : {};
  var isEdit = mode === "edit";
  var val = function (k, d) { return r[k] !== undefined && r[k] !== null ? r[k] : (d === undefined ? "" : d); };
  var ingredients = (r.ingredients && r.ingredients.length) ? r.ingredients : [""];
  var directions = (r.directions && r.directions.length) ? r.directions : [""];
%>
<div class="section-head">
  <div>
    <p class="eyebrow mb-1"><%= isEdit ? "Edit recipe" : "New recipe" %></p>
    <h1><%= isEdit ? r.title : "Share your recipe" %></h1>
  </div>
  <% if (isEdit) { %><a href="/recipes/<%= r.slug %>" class="btn btn-outline-secondary btn-sm">View recipe</a><% } %>
</div>

<form id="recipe-form" action="<%= isEdit ? '/recipes/' + r.slug + '?_method=PUT' : '/recipes' %>" method="POST" enctype="multipart/form-data">
  <div class="editor-grid">
    <div>
      <section class="editor-section surface surface-pad">
        <h2>The basics</h2>
        <div class="form-group">
          <label for="title">Recipe title <span class="text-danger">*</span></label>
          <input class="form-control form-control-lg" type="text" name="title" id="title" value="<%= val('title') %>" placeholder="e.g. Grandma's Buttermilk Pancakes" minlength="3" maxlength="200" required>
          <small class="form-text">Be specific: main ingredient plus dish type. This is your page title in Google.</small>
        </div>
        <div class="form-group">
          <label for="summary">One-sentence summary</label>
          <input class="form-control" type="text" name="summary" id="summary" value="<%= val('summary') %>" maxlength="300" placeholder="e.g. Fluffy, tangy pancakes ready in 20 minutes with pantry staples.">
          <small class="form-text"><span id="summaryCount">0</span>/300. Shown in search results and social previews.</small>
        </div>
        <div class="form-group mb-0">
          <label for="description">Description <span class="text-danger">*</span></label>
          <textarea class="form-control" id="description" name="description" rows="6" placeholder="Where does this recipe come from? What makes it special? Any tips for success?" required><%= seo.htmlToText(val('description')) %></textarea>
          <small class="form-text">Blank lines start new paragraphs.</small>
        </div>
      </section>

      <section class="editor-section surface surface-pad">
        <h2>Details</h2>
        <div class="form-row">
          <div class="form-group col-sm-4">
            <label for="prepTime">Prep (min) <span class="text-danger">*</span></label>
            <input class="form-control" type="number" name="prepTime" id="prepTime" value="<%= val('prepTime') %>" min="0" max="10000" required>
          </div>
          <div class="form-group col-sm-4">
            <label for="cookTime">Cook (min) <span class="text-danger">*</span></label>
            <input class="form-control" type="number" name="cookTime" id="cookTime" value="<%= val('cookTime') %>" min="0" max="10000" required>
          </div>
          <div class="form-group col-sm-4">
            <label for="servings">Servings</label>
            <input class="form-control" type="number" name="servings" id="servings" value="<%= val('servings') %>" min="1" max="500" placeholder="4">
          </div>
        </div>
        <p class="small text-muted">Total time: <strong id="totalTimeText"></strong></p>
        <div class="form-row">
          <div class="form-group col-sm-6">
            <label for="category">Category <span class="text-danger">*</span></label>
            <select class="custom-select" name="category" id="category" required>
              <% categories.forEach(function (c) { %><option value="<%= c %>" <%= val('category') === c ? 'selected' : '' %>><%= c %></option><% }); %>
            </select>
          </div>
          <div class="form-group col-sm-6">
            <label for="cuisine">Cuisine</label>
            <input class="form-control" type="text" name="cuisine" id="cuisine" value="<%= val('cuisine') %>" maxlength="60" placeholder="e.g. Italian, Mexican, American">
          </div>
        </div>
        <fieldset class="form-group">
          <legend class="col-form-label pt-0">Dietary</legend>
          <% var selected = r.allergens || []; diets.forEach(function (d) { var id = 'diet-' + d.toLowerCase().replace(/[^a-z]/g, ''); %>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="allergens[]" id="<%= id %>" value="<%= d %>" <%= selected.includes(d) ? 'checked' : '' %>>
            <label class="form-check-label font-weight-normal" for="<%= id %>"><%= d %></label>
          </div>
          <% }); %>
        </fieldset>
        <div class="form-group">
          <label for="tags">Tags <small class="text-muted font-weight-normal">(comma separated)</small></label>
          <input class="form-control" type="text" name="tags" id="tags" value="<%= (r.tags || []).join(', ') %>" maxlength="300" placeholder="e.g. weeknight, one-pot, kid-friendly">
        </div>
        <div class="form-group mb-0">
          <label for="difficultySlider">Difficulty: <span class="text-muted" id="rangeText">Easy</span></label>
          <input type="range" class="custom-range" id="difficultySlider" name="difficulty" value="<%= val('difficulty', 0) %>" min="0" max="2" step="1">
        </div>
      </section>

      <section class="editor-section surface surface-pad">
        <h2>Ingredients <span class="text-danger">*</span></h2>
        <p class="small text-muted">One per line, with the quantity. Press Enter to add another.</p>
        <div class="ingredients_input_fields_wrap">
          <% ingredients.forEach(function (ing) { %>
          <div class="repeat-row">
            <input class="form-control" type="text" name="ingredients[]" value="<%= ing %>" placeholder="e.g. 2 cups all-purpose flour" maxlength="500" required>
            <button class="btn btn-ghost btn-sm remove_field" type="button" aria-label="Remove"><i class="fas fa-times" aria-hidden="true"></i></button>
          </div>
          <% }); %>
          <button class="btn btn-outline-secondary btn-sm ingredients_add_field_button" type="button"><i class="fas fa-plus" aria-hidden="true"></i> Add ingredient</button>
        </div>
      </section>

      <section class="editor-section surface surface-pad">
        <h2>Directions <span class="text-danger">*</span></h2>
        <p class="small text-muted">One step per line. Press Enter to add another.</p>
        <div class="directions_input_fields_wrap">
          <% directions.forEach(function (step) { %>
          <div class="repeat-row">
            <input class="form-control" type="text" name="directions[]" value="<%= step %>" placeholder="Describe this step" maxlength="500" required>
            <button class="btn btn-ghost btn-sm remove_field" type="button" aria-label="Remove"><i class="fas fa-times" aria-hidden="true"></i></button>
          </div>
          <% }); %>
          <button class="btn btn-outline-secondary btn-sm directions_add_field_button" type="button"><i class="fas fa-plus" aria-hidden="true"></i> Add step</button>
        </div>
      </section>
    </div>

    <aside class="editor-side">
      <section class="editor-section surface surface-pad">
        <h2>Photo <% if (!isEdit) { %><span class="text-danger">*</span><% } %></h2>
        <img id="imagePreview" class="mb-3 <%= r.image ? '' : 'd-none' %>" src="<%= r.image ? seo.imageUrl(r.image, { width: 800, height: 600 }) : '' %>" alt="Recipe photo preview">
        <div class="custom-file">
          <input type="file" class="custom-file-input" name="image" id="image" accept="image/*" <%= isEdit ? "" : "required" %>>
          <label class="custom-file-label" for="image"><%= isEdit ? "Replace photo (optional)" : "Choose a photo" %></label>
        </div>
        <small class="form-text">JPG, PNG or WEBP up to 8 MB. Landscape photos look best.</small>
      </section>

      <% if (isEdit) { %>
      <section class="editor-section surface surface-pad">
        <h2>Web address</h2>
        <p class="small text-muted mb-2">Current: <code>/recipes/<%= r.slug %></code></p>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="regenerateSlug" id="regenerateSlug">
          <label class="form-check-label small font-weight-normal" for="regenerateSlug">Update the address to match the new title <span class="text-muted">(old links stop working)</span></label>
        </div>
      </section>
      <% } %>

      <button type="submit" class="btn btn-primary btn-lg btn-block"><%= isEdit ? "Save changes" : "Publish recipe" %></button>
      <% if (isEdit) { %><a href="/recipes/<%= r.slug %>" class="btn btn-ghost btn-block">Cancel</a><% } %>
    </aside>
  </div>
</form>
