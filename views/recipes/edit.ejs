<%- include("../partials/header") %>
<%- include("./_form", { mode: "edit", recipe: recipe }) %>

<div class="surface surface-pad mt-4" style="border-color: #f0c9bf;">
  <h2 class="h5 text-danger">Delete this recipe</h2>
  <p class="small text-muted mb-2">Permanently removes the recipe, its photo, reviews and comments.</p>
  <form action="/recipes/<%= recipe.slug %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this recipe? This cannot be undone.');">
    <button type="submit" class="btn btn-outline-danger btn-sm">Delete recipe</button>
  </form>
</div>
<%- include("../partials/footer") %>
