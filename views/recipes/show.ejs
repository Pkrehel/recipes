<%- include("../partials/header") %>
<% var totalReviews = reviews.length; var favs = (recipe.lovedBy || []).length; %>

<nav aria-label="Breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Home</a></li>
    <li class="breadcrumb-item"><a href="/recipes/collections/<%= recipe.category.toLowerCase() %>"><%= recipe.category %></a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= recipe.title %></li>
  </ol>
</nav>

<article class="recipe">
  <header class="recipe-head">
    <p class="eyebrow mb-0"><%= recipe.category %><% if (recipe.cuisine) { %> · <%= recipe.cuisine %><% } %></p>
    <h1><%= recipe.title %></h1>
    <% if (recipe.summary) { %><p class="lead"><%= recipe.summary %></p><% } %>
    <div class="recipe-meta">
      <span>By <a href="/users/<%= recipe.chef.id %>"><%= recipe.chef.avatar %> <%= recipe.chef.screenName %></a></span>
      <time datetime="<%= new Date(recipe.createdAt).toISOString() %>"><%= formatDate(recipe.createdAt) %></time>
      <% if (recipe.rating > 0) { %>
      <a href="#reviews" class="font-weight-normal"><%- include("../partials/stars", { rating: recipe.rating }) %> <strong><%= recipe.rating %></strong> <span class="text-muted">(<%= totalReviews %> review<%= totalReviews === 1 ? "" : "s" %>)</span></a>
      <% } %>
      <% if (favs) { %><span><i class="fas fa-heart" style="color: var(--berry)" aria-hidden="true"></i> <%= favs %></span><% } %>
    </div>
  </header>

  <div class="recipe-hero">
    <img src="<%= seo.imageUrl(recipe.image, { width: 1200, height: 675 }) %>"
         srcset="<%= seo.imageUrl(recipe.image, { width: 640, height: 360 }) %> 640w, <%= seo.imageUrl(recipe.image, { width: 1200, height: 675 }) %> 1200w, <%= seo.imageUrl(recipe.image, { width: 1800, height: 1013 }) %> 1800w"
         sizes="(max-width: 1200px) 100vw, 1180px" alt="<%= recipe.title %>" width="1200" height="675" fetchpriority="high">
    <form action="<%= recipe.url %>/love" method="POST">
      <button class="love-btn <%= loved ? 'loved' : '' %>" aria-label="<%= loved ? 'Remove from favorites' : 'Save to favorites' %>" title="<%= loved ? 'Remove from favorites' : 'Save to favorites' %>"><i class="<%= loved ? 'fas' : 'far' %> fa-heart" aria-hidden="true"></i></button>
    </form>
  </div>

  <div class="facts">
    <div class="fact"><div class="k">Prep</div><div class="v"><%= recipe.prepTime %> min</div></div>
    <div class="fact"><div class="k">Cook</div><div class="v"><%= recipe.cookTime %> min</div></div>
    <div class="fact"><div class="k">Total</div><div class="v"><%= recipe.totalTime %> min</div></div>
    <% if (recipe.servings) { %><div class="fact"><div class="k">Servings</div><div class="v"><%= recipe.servings %></div></div><% } %>
    <div class="fact"><div class="k">Difficulty</div><div class="v"><%= recipe.difficultyLabel %></div></div>
  </div>

  <div class="recipe-actions mb-3">
    <% if (recipe.allergens && recipe.allergens.length) { recipe.allergens.forEach(function (a) { %><a class="chip" href="/recipes/collections/<%= a.toLowerCase() %>"><%= a %></a><% }); } %>
    <% if (recipe.tags && recipe.tags.length) { recipe.tags.forEach(function (t) { %><a class="chip" href="/s?search=<%= encodeURIComponent(t) %>">#<%= t %></a><% }); } %>
    <span class="ml-auto d-flex" style="gap: .5rem">
      <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="fas fa-print" aria-hidden="true"></i> Print</button>
      <% if (isOwner) { %><a href="<%= recipe.url %>/edit" class="btn btn-outline-secondary btn-sm"><i class="fas fa-pen" aria-hidden="true"></i> Edit</a><% } %>
    </span>
  </div>

  <% if (recipe.description) { %>
  <div class="description-rich surface surface-pad mb-4"><%- recipe.description %></div>
  <% } %>

  <div class="recipe-body">
    <section class="ingredients-card surface surface-pad" aria-labelledby="ingredients-heading">
      <h2 id="ingredients-heading" class="h4 mb-3">Ingredients</h2>
      <ul>
        <% recipe.ingredients.forEach(function (ing, i) { %>
        <li><label><input type="checkbox" aria-label="Mark ingredient as gathered"><span><%= ing %></span></label></li>
        <% }); %>
      </ul>
    </section>
    <section aria-labelledby="directions-heading">
      <h2 id="directions-heading" class="h4 mb-2">Directions</h2>
      <ol class="steps">
        <% recipe.directions.forEach(function (step, i) { %>
        <li id="step-<%= i + 1 %>"><div><p><%= step %></p></div></li>
        <% }); %>
      </ol>
    </section>
  </div>
</article>

<section id="reviews" class="mt-5" aria-labelledby="reviews-heading">
  <div class="section-head">
    <h2 id="reviews-heading">Reviews</h2>
    <% if (totalReviews) { %><span class="count"><%- include("../partials/stars", { rating: recipe.rating }) %> <%= recipe.rating %> · <%= totalReviews %> review<%= totalReviews === 1 ? "" : "s" %></span><% } %>
  </div>
  <div class="row">
    <div class="col-lg-5 mb-4">
      <div class="surface surface-pad">
        <% if (!currentUser) { %>
          <h3 class="h5">Made this recipe?</h3>
          <p class="text-muted mb-3">Log in to leave a star rating and notes for other cooks.</p>
          <a href="/login" class="btn btn-primary btn-block">Log in</a>
          <a href="/register" class="btn btn-outline-primary btn-block">Create an account</a>
        <% } else if (userReview) { %>
          <h3 class="h5">Your review</h3>
          <p class="mb-1"><%- include("../partials/stars", { rating: userReview.rating }) %></p>
          <% if (userReview.text) { %><p class="text-muted"><%= userReview.text %></p><% } %>
          <form action="<%= recipe.url %>/reviews/<%= userReview._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete your review?');">
            <button class="btn btn-sm btn-outline-danger">Delete review</button>
          </form>
        <% } else { %>
          <h3 class="h5">Rate this recipe</h3>
          <form action="<%= recipe.url %>/reviews" method="POST">
            <fieldset class="form-group star-rating">
              <legend class="sr-only">Star rating</legend>
              <% for (var s = 5; s >= 1; s--) { %>
              <input type="radio" id="rate-<%= s %>" name="review[rating]" value="<%= s %>" <%= s === 5 ? "checked" : "" %> required>
              <label for="rate-<%= s %>" title="<%= s %> star<%= s === 1 ? '' : 's' %>"><i class="fas fa-star" aria-hidden="true"></i><span class="sr-only"><%= s %> stars</span></label>
              <% } %>
            </fieldset>
            <div class="form-group">
              <label for="review-text" class="sr-only">Review</label>
              <textarea class="form-control" id="review-text" name="review[text]" placeholder="How did it turn out? Any tips or substitutions?" rows="4" maxlength="2000"></textarea>
            </div>
            <button class="btn btn-primary btn-block">Submit review</button>
          </form>
        <% } %>
      </div>
    </div>
    <div class="col-lg-7">
      <% if (reviews.length === 0) { %>
        <p class="text-muted">No reviews yet. Be the first.</p>
      <% } %>
      <% reviews.forEach(function (review) { %>
      <article class="review">
        <div class="who">
          <%- include("../partials/stars", { rating: review.rating }) %>
          <strong><%= review.author.screenName %></strong>
          <time datetime="<%= new Date(review.createdAt).toISOString() %>"><%= formatDate(review.createdAt) %></time>
        </div>
        <% if (review.text) { %><p class="mb-0"><%= review.text %></p><% } %>
      </article>
      <% }); %>
    </div>
  </div>
</section>

<section id="comments" class="mt-5" aria-labelledby="comments-heading">
  <div class="section-head">
    <h2 id="comments-heading">Comments</h2>
    <% if (comments.length) { %><span class="count"><%= comments.length %></span><% } %>
  </div>
  <div class="row">
    <div class="col-lg-7">
      <% if (currentUser) { %>
      <form action="<%= recipe.url %>/comments" method="POST" class="mb-4">
        <div class="form-group">
          <label for="comment-text" class="sr-only">Comment</label>
          <textarea class="form-control" id="comment-text" name="comment[text]" rows="3" maxlength="2000" placeholder="Ask a question or share how it went..." required></textarea>
        </div>
        <button class="btn btn-outline-primary">Post comment</button>
      </form>
      <% } else { %>
      <p class="text-muted"><a href="/login">Log in</a> to join the conversation.</p>
      <% } %>
      <% comments.forEach(function (c) { %>
      <div class="review">
        <div class="who"><strong><%= c.author.screenName %></strong> <time datetime="<%= new Date(c.createdAt).toISOString() %>"><%= formatDate(c.createdAt) %></time></div>
        <p class="mb-1"><%= c.text %></p>
        <% if (currentUser && String(c.author.id) === String(currentUser._id)) { %>
        <form action="<%= recipe.url %>/comments/<%= c._id %>?_method=DELETE" method="POST" class="d-inline">
          <button class="btn btn-link btn-sm text-danger p-0">Delete</button>
        </form>
        <% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include("../partials/footer") %>
