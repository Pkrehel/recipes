<%- include("./partials/header") %>
<div class="py-4">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card thick-border register-login-form">
        <div class="card-body">
          <h1 class="h2 mb-3 text-center text-primary">Reset Password</h1>
          <p class="small text-muted text-center">Enter your account email and we'll send you a reset link.</p>
          <form action="/forgot" method="POST">
            <div class="form-group">
              <label for="forgot-email">Email</label>
              <input type="email" class="form-control" id="forgot-email" name="email" autocomplete="email" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
          </form>
          <p class="text-center small mt-3 mb-0"><a href="/login">Back to log in</a></p>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include("./partials/footer") %>
