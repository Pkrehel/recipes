<%- include("./partials/header") %>
<div class="auth-wrap">
  <h1>Reset your password</h1>
  <p class="sub">Enter your account email and we'll send a reset link.</p>
  <div class="surface surface-pad">
    <form action="/forgot" method="POST">
      <div class="form-group">
        <label for="forgot-email">Email</label>
        <input type="email" class="form-control" id="forgot-email" name="email" autocomplete="email" required autofocus>
      </div>
      <button type="submit" class="btn btn-primary btn-lg btn-block">Send reset link</button>
    </form>
  </div>
  <p class="text-center small mt-3 text-muted"><a href="/login">Back to log in</a></p>
</div>
<%- include("./partials/footer") %>
