<%- include("./partials/header") %>

<div class="section-head">
  <div>
    <p class="eyebrow mb-1">Search</p>
    <h1>&ldquo;<%= term %>&rdquo;</h1>
  </div>
  <span class="count"><%= count %> result<%= count === 1 ? "" : "s" %></span>
</div>

<% if (recipes.length === 0) { %>
  <div class="empty">
    <h3>Nothing matched &ldquo;<%= term %>&rdquo;</h3>
    <p class="mb-3">Try a different ingredient or dish name.</p>
    <a href="/" class="btn btn-outline-primary">Browse the latest recipes</a>
  </div>
<% } else { %>
  <div class="recipe-grid">
    <% recipes.forEach(function (r, i) { %>
      <%- include("./partials/recipe-card", { r: r, eager: i < 3 }) %>
    <% }); %>
  </div>
  <%- include("./partials/pagination") %>
<% } %>

<%- include("./partials/footer") %>
