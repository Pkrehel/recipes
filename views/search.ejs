<%- include("./partials/header") %>

<header class="py-3">
  <h1 class="text-primary font-weight-bold h2 mb-1">Search results for &ldquo;<%= term %>&rdquo;</h1>
  <p class="small text-muted mb-0"><%= count %> recipe<%= count === 1 ? "" : "s" %> found</p>
</header>

<% if (recipes.length === 0) { %>
  <div class="text-center py-5">
    <p class="lead">No recipes matched &ldquo;<%= term %>&rdquo;.</p>
    <p class="text-muted">Try a different ingredient or dish name, or <a href="/">browse the newest recipes</a>.</p>
  </div>
<% } else { %>
  <div class="row">
    <% recipes.forEach(function (r, i) { %>
      <%- include("./partials/recipe-card", { r: r, eager: i < 3 }) %>
    <% }); %>
  </div>
  <%- include("./partials/pagination") %>
<% } %>

<%- include("./partials/footer") %>
