<%- include("./partials/header") %>
<div class="auth-wrap">
  <h1>Welcome back</h1>
  <p class="sub">Log in to your account.</p>
  <div class="surface surface-pad">
    <form action="/login" method="POST">
      <div class="form-group">
        <label for="login-email">Email</label>
        <input type="email" class="form-control" id="login-email" name="username" autocomplete="username" required autofocus>
      </div>
      <div class="form-group">
        <div class="d-flex justify-content-between align-items-baseline">
          <label for="login-password">Password</label>
          <a href="/forgot" class="small">Forgot password?</a>
        </div>
        <input type="password" class="form-control" id="login-password" name="password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-lg btn-block">Log in</button>
    </form>
  </div>
  <p class="text-center small mt-3 text-muted">New here? <a href="/register"><strong>Create an account</strong></a></p>
</div>
<%- include("./partials/footer") %>
