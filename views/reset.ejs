<%- include("./partials/header") %>
<div class="py-4">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card thick-border register-login-form">
        <div class="card-body">
          <h1 class="h2 mb-3 text-center text-primary">Choose a New Password</h1>
          <form action="/reset/<%= token %>" method="POST">
            <div class="form-group">
              <label for="new-password">New password <small class="text-muted">(8+ characters)</small></label>
              <input type="password" class="form-control" id="new-password" name="password" minlength="8" maxlength="128" autocomplete="new-password" required autofocus>
            </div>
            <div class="form-group">
              <label for="confirm-password">Confirm password</label>
              <input type="password" class="form-control" id="confirm-password" name="confirm" minlength="8" maxlength="128" autocomplete="new-password" required>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Update password</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include("./partials/footer") %>
