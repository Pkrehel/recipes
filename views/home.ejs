<%- include("./partials/header") %>

<header class="py-3">
  <h1 class="text-primary font-weight-bold h2 mb-1"><%= pageTitle %></h1>
  <% if (typeof description !== "undefined" && description) { %><p class="text-muted mb-0"><%= description %></p><% } %>
  <% if (count > 0) { %><p class="small text-muted mb-0"><%= count %> recipe<%= count === 1 ? "" : "s" %></p><% } %>
</header>

<% if (recipes.length === 0) { %>
  <div class="text-center py-5">
    <p class="lead">No recipes here yet.</p>
    <% if (currentUser) { %><a href="/recipes/new" class="btn btn-primary">Be the first to share one</a><% } else { %><a href="/register" class="btn btn-primary">Create an account to share a recipe</a><% } %>
  </div>
<% } else { %>
  <div class="row" id="recentRecipesSection">
    <% recipes.forEach(function (r, i) { %>
      <%- include("./partials/recipe-card", { r: r, eager: i < 3 }) %>
    <% }); %>
  </div>
  <%- include("./partials/pagination") %>
<% } %>

<%- include("./partials/footer") %>
