<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>">
  <meta name="robots" content="<%= meta.robots %>">
  <meta name="theme-color" content="#faf7f1">
  <% if (meta.canonical) { %><link rel="canonical" href="<%= meta.canonical %>"><% } %>
  <% if (meta.prev) { %><link rel="prev" href="<%= meta.prev %>"><% } %>
  <% if (meta.next) { %><link rel="next" href="<%= meta.next %>"><% } %>

  <!-- Open Graph / Twitter -->
  <meta property="og:site_name" content="<%= meta.site.name %>">
  <meta property="og:type" content="<%= meta.ogType %>">
  <meta property="og:title" content="<%= meta.rawTitle %>">
  <meta property="og:description" content="<%= meta.description %>">
  <% if (meta.canonical) { %><meta property="og:url" content="<%= meta.canonical %>"><% } %>
  <meta property="og:locale" content="<%= meta.site.locale %>">
  <% if (meta.image) { %>
  <meta property="og:image" content="<%= meta.image %>">
  <meta property="og:image:alt" content="<%= meta.imageAlt %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="<%= meta.image %>">
  <% } else { %>
  <meta name="twitter:card" content="summary">
  <% } %>
  <meta name="twitter:title" content="<%= meta.rawTitle %>">
  <meta name="twitter:description" content="<%= meta.description %>">
  <% if (meta.site.twitter) { %><meta name="twitter:site" content="<%= meta.site.twitter %>"><% } %>
  <% if (meta.publishedTime) { %><meta property="article:published_time" content="<%= new Date(meta.publishedTime).toISOString() %>"><% } %>
  <% if (meta.modifiedTime) { %><meta property="article:modified_time" content="<%= new Date(meta.modifiedTime).toISOString() %>"><% } %>

  <!-- Structured data -->
  <% meta.jsonLd.forEach(function (json) { %>
  <script type="application/ld+json"><%- json %></script>
  <% }); %>

  <link rel="icon" href="/images/icons/knife-60x60.png" type="image/png">
  <link rel="apple-touch-icon" href="/images/icons/knife-60x60.png">
  <link rel="alternate" type="application/json" title="Recipes API" href="/api/v1/recipes">

  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600&family=Amatic+SC:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/animation.css">
  <link rel="stylesheet" href="/stylesheets/theme.css">

  <% if (gtmId) { %>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%= gtmId %>');</script>
  <!-- End Google Tag Manager -->
  <% } %>
</head>

<body>
<% if (gtmId) { %>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= gtmId %>" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<% } %>

<!-- Full-page pancake-flip loading animation, shown while a recipe uploads -->
<div id="cooking-container" role="status" aria-live="polite">
  <div id="cooking">
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div id="area">
      <div id="sides">
        <div id="pan"></div>
        <div id="handle"></div>
      </div>
      <div id="pancake">
        <div id="pastry"></div>
      </div>
    </div>
    <h4>Uploading Your Recipe...</h4>
  </div>
</div>

<div id="fullPageHide">
<a class="sr-only sr-only-focusable" href="#main-content">Skip to main content</a>

<header class="site-header">
  <div class="container">
    <nav class="navbar navbar-expand-lg p-0" aria-label="Primary">
      <a href="/" class="brand navbar-brand m-0 p-0" aria-label="<%= meta.site.name %> home">
        <span class="brand-mark" aria-hidden="true">
          <span id="cooking-container-navigation">
            <span id="cooking-navigation" class="left">
              <span id="area">
                <span id="sides"><span id="pan"></span><span id="handle"></span></span>
                <span id="pancake"><span id="pastry"></span></span>
              </span>
            </span>
          </span>
        </span>
        <span class="brand-word"><%= meta.site.name %></span>
      </a>

      <button class="navbar-toggler ml-auto" type="button" data-toggle="collapse" data-target="#siteNav" aria-controls="siteNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="siteNav">
        <form action="/s" method="GET" role="search" class="nav-search mx-lg-4 w-100">
          <label for="searchbar" class="sr-only">Search recipes</label>
          <input class="form-control" id="searchbar" name="search" type="search" placeholder="Search recipes, ingredients..." value="<%= searchQuery %>" maxlength="100" autocomplete="off">
        </form>

        <ul class="navbar-nav ml-auto align-items-lg-center">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="browseMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Browse</a>
            <div class="dropdown-menu dropdown-menu-right browse-menu" aria-labelledby="browseMenu">
              <div class="row no-gutters">
                <div class="col-6 col-lg-3">
                  <h6>Meal</h6>
                  <a class="dropdown-item" href="/recipes/collections/breakfast">Breakfast</a>
                  <a class="dropdown-item" href="/recipes/collections/lunch">Lunch</a>
                  <a class="dropdown-item" href="/recipes/collections/dinner">Dinner</a>
                  <a class="dropdown-item" href="/recipes/collections/snack">Snacks</a>
                  <a class="dropdown-item" href="/recipes/collections/dessert">Dessert</a>
                  <a class="dropdown-item" href="/recipes/collections/beverage">Drinks</a>
                </div>
                <div class="col-6 col-lg-3">
                  <h6>Diet</h6>
                  <a class="dropdown-item" href="/recipes/collections/vegetarian">Vegetarian</a>
                  <a class="dropdown-item" href="/recipes/collections/vegan">Vegan</a>
                  <a class="dropdown-item" href="/recipes/collections/gluten-free">Gluten-Free</a>
                  <a class="dropdown-item" href="/recipes/collections/dairy-free">Dairy-Free</a>
                  <a class="dropdown-item" href="/recipes/collections/nut-free">Nut-Free</a>
                </div>
                <div class="col-6 col-lg-3">
                  <h6>Time</h6>
                  <a class="dropdown-item" href="/recipes/collections/quick">10 minutes or less</a>
                  <a class="dropdown-item" href="/recipes/collections/under-45-minutes">Under 45 minutes</a>
                  <a class="dropdown-item" href="/recipes/collections/weekend-projects">Weekend projects</a>
                </div>
                <div class="col-6 col-lg-3">
                  <h6>Popular</h6>
                  <a class="dropdown-item" href="/">Newest</a>
                  <a class="dropdown-item" href="/recipes/collections/most-viewed">Most viewed</a>
                  <a class="dropdown-item" href="/recipes/collections/highest-rated">Highest rated</a>
                  <a class="dropdown-item" href="/recipes/collections/easy">Easy</a>
                </div>
              </div>
            </div>
          </li>

          <% if (!currentUser) { %>
          <li class="nav-item"><a class="nav-link" href="/login">Log in</a></li>
          <li class="nav-item ml-lg-2 mt-2 mt-lg-0"><a class="btn btn-primary btn-block" href="/register">Sign up</a></li>
          <% } else { %>
          <li class="nav-item ml-lg-2 mt-2 mt-lg-0"><a class="btn btn-accent btn-block" href="/recipes/new"><i class="fas fa-plus mr-1" aria-hidden="true"></i> Post a recipe</a></li>
          <li class="nav-item dropdown ml-lg-2 mt-2 mt-lg-0">
            <a class="avatar-pill" href="#" id="profileMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <span class="emoji" aria-hidden="true"><%= currentUser.avatar %></span> <%= currentUser.screenName %>
            </a>
            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="profileMenu">
              <a class="dropdown-item" href="/users/<%= currentUser._id %>">My profile</a>
              <a class="dropdown-item" href="/users/<%= currentUser._id %>#favorites">Favorites</a>
              <div class="dropdown-divider"></div>
              <form action="/logout" method="POST" class="m-0"><button type="submit" class="dropdown-item">Log out</button></form>
            </div>
          </li>
          <% } %>
        </ul>
      </div>
    </nav>
  </div>
</header>

<div class="alert-container">
  <% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    <%= error %>
  </div>
  <% } %>
  <% if (success && success.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    <%= success %>
  </div>
  <% } %>
</div>

<main id="main-content" class="container">
