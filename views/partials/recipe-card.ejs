<%
  // Expects `r` (lean recipe) and optional `eager` (boolean) for above-the-fold images.
  var href = "/recipes/" + r.slug;
  var isEager = typeof eager !== "undefined" && eager;
  var isLoved = currentUser && (r.lovedBy || []).some(function (id) { return String(id) === String(currentUser._id); });
  var reviewCount = (r.reviews || []).length;
%>
<article class="recipe-card">
  <div class="media">
    <img src="<%= seo.imageUrl(r.image, { width: 600, height: 450 }) %>"
         srcset="<%= seo.imageUrl(r.image, { width: 400, height: 300 }) %> 400w, <%= seo.imageUrl(r.image, { width: 600, height: 450 }) %> 600w, <%= seo.imageUrl(r.image, { width: 900, height: 675 }) %> 900w"
         sizes="(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw"
         alt="<%= r.title %>" width="600" height="450"
         loading="<%= isEager ? 'eager' : 'lazy' %>" <%- isEager ? 'fetchpriority="high"' : 'decoding="async"' %>>
    <form action="<%= href %>/love" method="POST">
      <button class="love-btn <%= isLoved ? 'loved' : '' %>" aria-label="<%= isLoved ? 'Remove from' : 'Add to' %> favorites" title="<%= isLoved ? 'Remove from favorites' : 'Add to favorites' %>"><i class="<%= isLoved ? 'fas' : 'far' %> fa-heart" aria-hidden="true"></i></button>
    </form>
  </div>
  <div class="card-body">
    <div class="meta">
      <span class="eyebrow"><%= r.category %></span>
      <span aria-hidden="true">·</span>
      <span><i class="far fa-clock" aria-hidden="true"></i> <%= r.totalTime %> min</span>
      <% if (r.rating > 0) { %><span aria-hidden="true">·</span><span class="stars"><i class="fas fa-star" aria-hidden="true"></i> <%= r.rating %><% if (reviewCount) { %> <span class="text-muted">(<%= reviewCount %>)</span><% } %></span><% } %>
    </div>
    <h3><a href="<%= href %>"><%= r.title %></a></h3>
    <% if (r.allergens && r.allergens.length) { %><div class="diet"><%= r.allergens.join(" · ") %></div><% } %>
    <div class="foot">
      <a href="/users/<%= r.chef.id %>"><%= r.chef.avatar || "" %> <%= r.chef.screenName %></a>
      <time datetime="<%= new Date(r.createdAt).toISOString() %>"><%= formatDate(r.createdAt) %></time>
    </div>
  </div>
</article>
