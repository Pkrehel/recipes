<% if (!currentUser) { %>
<!-- Slide-out panel: sign up / login -->
<div class="cd-panel cd-panel--from-right js-cd-panel-main">
  <div class="container">
    <header class="cd-panel__header">
      <div class="container">
        <div class="row text-center">
          <div class="col-6 accountToggleButton" role="button" tabindex="0"><h2 class="h1">Sign Up</h2></div>
          <div class="col-6 accountToggleButton" role="button" tabindex="0"><h2 class="h1">Login</h2></div>
        </div>
        <a href="#0" class="cd-panel__close js-cd-close">Close</a>
      </div>
    </header>
  </div>
  <div class="cd-panel__container">
    <div class="cd-panel__content">
      <div class="accountToggleContainer">
        <h4 class="text-center font-weight-bold text-primary">Sign Up</h4>
        <div class="dropdown-divider"></div>
        <%- include("./register-form", { idPrefix: "panel" }) %>
      </div>
      <div class="accountToggleContainer" style="display: none">
        <h4 class="text-center font-weight-bold text-primary">Login</h4>
        <div class="dropdown-divider"></div>
        <form class="px-1 py-2" action="/login" method="POST">
          <div class="form-group">
            <label for="panel-email">Email</label>
            <input type="email" class="form-control" id="panel-email" name="username" autocomplete="username" required>
          </div>
          <div class="form-group">
            <label for="panel-password">Password</label>
            <input type="password" class="form-control" id="panel-password" name="password" autocomplete="current-password" required>
          </div>
          <button type="submit" class="btn btn-secondary btn-block btn-lg my-2"><b>Sign In</b></button>
        </form>
        <div class="small">
          <p class="text-center">Don't have an account? <b><a href="/register">Create Profile</a></b></p>
          <p class="text-center">Forgot your password? <b><a href="/forgot">Reset Password</a></b></p>
        </div>
      </div>
    </div>
  </div>
</div>
<% } else { %>
<!-- Slide-out panel: favorites -->
<div class="cd-panel cd-panel--from-right js-cd-panel-main container">
  <div class="row">
    <header class="cd-panel__header container">
      <div class="col-12 text-center"><h2 class="h1">Favorite Recipes</h2></div>
      <a href="#0" class="cd-panel__close js-cd-close">Close</a>
    </header>
  </div>
  <div class="cd-panel__container">
    <div class="cd-panel__content">
      <div class="container">
        <div class="row">
          <% if (!currentUser.lovedRecipes || currentUser.lovedRecipes.length === 0) { %>
          <p class="px-3">You haven't favorited any recipes yet. Click the <i class="fas fa-heart" aria-hidden="true"></i> icon on a recipe to save it here.</p>
          <% } else { currentUser.lovedRecipes.forEach(function (r) { %>
          <div class="col-12 col-sm-6 mb-3">
            <div class="card card-light w-100">
              <div class="img-container">
                <a href="/recipes/<%= r.slug %>"><img class="card-img-top smallImageSlideout" src="<%= seo.imageUrl(r.image, { width: 400, height: 300 }) %>" alt="<%= r.title %>" loading="lazy" width="400" height="300"></a>
                <div class="recipeBookButton text-center">
                  <form action="/recipes/<%= r.slug %>/love?_method=DELETE" method="POST">
                    <button type="submit" class="btn rounded-circle like-btn-homepage" aria-label="Remove <%= r.title %> from favorites"><i class="fas fa-heart-broken" aria-hidden="true"></i></button>
                  </form>
                </div>
              </div>
              <div class="card-body smallImageSlideoutBody px-1 py-2 text-center">
                <h5 class="card-title"><a href="/recipes/<%= r.slug %>" class="text-dark"><%= r.title %></a></h5>
                <h6 class="card-subtitle mb-2 text-muted"><i class="far fa-clock" aria-hidden="true"></i>&nbsp;<%= r.totalTime %> minutes</h6>
                <a href="/recipes/<%= r.slug %>" class="btn btn-outline-primary btn-block recipe-view-button my-1">View</a>
              </div>
            </div>
          </div>
          <% }); } %>
        </div>
      </div>
      <div class="row" id="invisible-sliding-footer"></div>
      <div class="slider-footer-container">
        <div class="slider-footer-contents container">
          <form action="/logout" method="POST"><button type="submit" class="btn btn-outline-danger btn-block btn-lg my-2">Logout</button></form>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>
