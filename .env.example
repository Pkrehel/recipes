# Copy to .env for local development. On Render, set these in the dashboard (render.yaml lists them).

# --- Required ---
MONGODB_URI=mongodb://127.0.0.1:27017/recipes
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap, JSON-LD and email links.
SITE_URL=http://localhost:3000
# Optional: force a single host in production (e.g. www.yourdomain.com). Requests to other hosts 301 here.
# CANONICAL_HOST=www.yourdomain.com

# --- Cloudinary (recipe photos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (verification + password reset). Leave blank locally to log emails to the console. ---
# Namecheap Private Email example: host mail.privateemail.com, port 587, secure false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Optional ---
SITE_NAME=Flippin' Good Recipes
GTM_ID=
TWITTER_HANDLE=
DEFAULT_OG_IMAGE=
PORT=3000
